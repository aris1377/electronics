<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/products.css" />

<body>
  <div class="products-container">
     <video autoplay muted loop class="background-video">
    <source src="/video/wat.mp4" type="video/mp4" />
  </video>
    <div class="navigation-menu">
      <ul class="nav justify-content-center">
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link active" href="/admin/">Home</a>
        </li>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/product/all">Menu</a>
        </li>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/user/all">Users</a>
        </li>
        <li
          class="nav-item"
          style="cursor: pointer"
          onclick="return confirm('Do you want to logout?')"
        >
          <a class="nav-link" href="/admin/logout">Logout</a>
        </li>
      </ul>
    </div>

    <div class="restaurant-menu-frame">
      <div class="board">
        <div class="dishes-table">
          <span class="new-dish-txt" style="margin-bottom: 30px">
            SHOP MENU
          </span>
          <table class="table table-bordered table-hover">
            <thead class="thead-light">
              <tr class="thead-light">
                <th scope="col">T/r</th>
                <th scope="col">Product Name</th>
                <th scope="col">Product Type</th>
                <th scope="col">Product Gender</th>
                <th scope="col">Product Age</th>
                <th scope="col">Product Size</th>
                <th scope="col">Product Price</th>
                <th scope="col">Product Left Count</th>
                <th scope="col">Status</th>
              </tr>
            </thead>
            <!--  LOOP PRODUCTS: START  -->
           <% products.map(function(value, key) { %>
              <tbody style="background: white">
                <tr>
                  <td><%= key + 1 %></td>
                  <td><%= value.productName %></td>
                  <td><%= value.productCollection %></td>
                  <td><%= value.productGender %></td>
                  <td><%= value.productAgeRange %></td>

                <% if (value.productCollection === 'CLOTHING') { %>
                    <td><%= value.productClothingSize %></td>
                  <% } else if (value.productCollection === 'KIDS_TOYS') { %>
                    <td><%= value.productToySize %></td>
                  <% } else { %>
                    <td>-</td> <!-- yoki bo'sh <td></td> -->
                  <% } %>


                  <td><%= value.productPrice %></td>
                  <td><%= value.productLeftCount %></td>
                  <td>
                    <select class="spec-select new-product-status" id="<%= value._id %>">
                      <option value="PAUSE" <%= value.productStatus === 'PAUSE' ? 'selected' : '' %>>PAUSE</option>
                      <option value="PROCESS" <%= value.productStatus === 'PROCESS' ? 'selected' : '' %>>PROCESS</option>
                      <option value="DELETE" <%= value.productStatus === 'DELETE' ? 'selected' : '' %>>DELETE</option>
                    </select>
                  </td>
                </tr>
              </tbody>
            <% }) %>

            <!--  LOOP PRODUCTS: END  -->
          </table>
          <div
            class="long-input"
            style="align-items: flex-end; margin-bottom: 25px"
          >
            <button class="btn btn-primary" id="process-btn">
              New Product
            </button>
          </div>
        </div>
         <form
        onsubmit="return validateForm()"
          action="/admin/product/create"
          method="POST"
          class="dish-container"
          enctype="multipart/form-data"
        >
          <div class="long-input" style="display: flex; align-items: center">
            <span class="new-dish-txt">NEW PRODUCT DETAIL</span>
          </div>
          <div class="login-input-frame">
            <div class="long-input">
              <label>Product Name</label>
              <input
                type="text"
                placeholder="Name"
                name="productName"
                class="product-name"
              />
            </div>
            <input
              name="productStatus"
              value="PAUSE"
              class="product-status"
              hidden
            />
          </div>
          <div class="half-input-frame">
            <div class="half-input">
              <label>Product Price</label>
              <input
                type="number"
                placeholder="Price"
                name="productPrice"
                class="product-price"
              />
            </div>

            
            <div class="half-input">
              <label>Product Left Counts</label>
              <input
                type="number"
                placeholder="Counts"
                name="productLeftCount"
                class="product-left-count"
              />
            </div>
          </div>
          <div class="half-input-frame">
            <div class="half-input">
              <label>Product Collection</label>
              <select class="product-collection" name="productCollection">
                <option value="KIDS_TOYS" selected>KIDS-TOYS</option>
                <option value="BOOKS">BOOKS</option>
                <option value="CLOTHING">CLOTHING</option>
                <option value="OTHER">Other</option>
              </select>
            </div>
                  <!-- Product Gender -->
                <div class="half-input">
                  <label>Product Gender</label>
                  <select class="product-collection" name="productGender">
                    <option value="GIRLS" selected>GIRLS</option>
                    <option value="BOYS">BOYS</option>
                  </select>
                </div>

                <!-- Product Age Range -->
                <div class="half-input">
                  <label>Product Age Range</label>
                  <select class="product-collection" name="productAgeRange">
                    <option value="AGE_0_3" selected>AGE_0_3</option>
                    <option value="AGE_3_5">AGE_3_5</option>
                    <option value="AGE_6_7">AGE_6_7</option>
                    <option value="AGE_8_10">AGE_8_10</option>
                  </select>
                </div>

                <!-- Toy Type -->
                <div class="half-input">
                  <label>Toy Type</label>
                  <select class="product-collection" name="toyType">
                    <option value="EDUCATIONAL" selected>EDUCATIONAL</option>
                    <option value="FUN">FUN</option>
                    <option value="MUSICAL">MUSICAL</option>
                    <option value="PUZZLE">PUZZLE</option>
                  </select>
                </div>

                <!-- Toy Color -->
                <div class="half-input">
                  <label>Toy Color</label>
                  <select class="product-collection" name="toyColor">
                    <option value="RED" selected>RED</option>
                    <option value="BLUE">BLUE</option>
                    <option value="SKY_BLUE">SKY_BLUE</option>
                    <option value="ORANGE">ORANGE</option>
                  </select>
                </div>

                <div class="half-input">
                  <label>Toy Size</label>
                  <select class="product-collection" name="productToySize">
                    <option value="SMALL" selected>SMALL</option>
                    <option value="MEDIUM">MEDIUM</option>
                    <option value="LARGE">LARGE</option>
                  </select>
                </div>

                <!-- Clothing Color -->
                <div class="half-input">
                  <label>Clothing Color</label>
                  <select class="product-collection" name="clothingColor">
                    <option value="BLUE">BLUE</option>
                    <option value="GRAY" selected>GRAY</option>
                    <option value="GREEN">GREEN</option>
                    <option value="YELLOW">YELLOW</option>
                    <option value="RED">RED</option>
                    <option value="ORANGE">ORANGE</option>
                    <option value="PINK">PINK</option>
                    <option value="WHITE">WHITE</option>
                    <option value="PURPLE">PURPLE</option>
                    <option value="GOLD">GOLD</option>
                    <option value="PEACH">PEACH</option>
                  </select>
                </div>

                 <div class="half-input">
                  <label>Clothing Size</label>
                  <select class="product-collection" name="productClothingSize">
                    <option value="XS" selected>XS</option>
                    <option value="S">S</option>
                    <option value="M">M</option>
                    <option value="L">L</option>
                    <option value="XL">XL</option>
                  </select>
                </div>

                <!-- Book Language -->
                <div class="half-input">
                  <label>Book Language</label>
                  <select class="product-collection" name="bookLanguage">
                    <option value="UZBEK">UZBEK</option>
                    <option value="RUSSIAN" selected>RUSSIAN</option>
                    <option value="ENGLISH">ENGLISH</option>
                    <option value="KOREAN">KOREAN</option>
                  </select>
                </div>

                <!-- Book Cover Type -->
                <div class="half-input">
                  <label>Book Cover Type</label>
                  <select class="product-collection" name="bookCoverType">
                    <option value="HARD">Hard Cover</option>
                    <option value="SOFT" selected>Soft Cover</option>
                  </select>
                </div>

  
              </div>
              <div class="long-input">
            <label>Product Description</label>
            <textarea name="productDesc" class="product-desc"></textarea>
          </div>

          <div class="img-frame">
            <label>Product Images</label>
            <div class="media-frame">
              <div class="upload-img-box">
                <img src="/img/upload.svg" class="1" id="image-section-1" />
                <input
                  type="file"
                  id="file"
                  name="productImages"
                  class="image-one"
                  required
                />
              </div>
              <div class="upload-img-box">
                <img src="/img/upload.svg" class="2" id="image-section-2" />
                <input
                  type="file"
                  id="file"
                  name="productImages"
                  class="image-two"
                />
              </div>
              <div class="upload-img-box">
                <img src="/img/upload.svg" class="3" id="image-section-3" />
                <input
                  type="file"
                  id="file"
                  name="productImages"
                  class="image-three"
                />
              </div>
              <div class="upload-img-box">
                <img src="/img/upload.svg" class="4" id="image-section-4" />
                <input
                  type="file"
                  id="file"
                  name="productImages"
                  class="image-four"
                />
              </div>
              <div class="upload-img-box">
                <img src="/img/upload.svg" class="5" id="image-section-5" />
                <input
                  type="file"
                  id="file"
                  name="productImages"
                  class="image-five"
                />
              </div>
              <input name="restaurantIid" class="restaurant-id" hidden />
            </div>
          </div>

          <div class="operation-buttons">
            <button class="btn btn-danger" id="cancel-btn">Cancel</button>
            <button type="submit" class="btn btn-primary" id="create-btn">
              Create
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script type="text/javascript" src="/js/products.js"></script>
</body>

<%- include('includes/footer') %>
